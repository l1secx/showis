# Showis deploy ortami ornegi — `infra/.env` olarak kopyalayin (chmod 600).
# DEGER YAZMAYIN: gercek degerler yalniz `infra/.env` icinde tutulur, repoya girmez.
#
# T-336: asagidaki ZORUNLU degiskenlerin guvensiz varsayilanlari KALDIRILDI.
# Biri bos/eksikse `docker compose` komutlari fail-fast eder (config/ps/up dahil).
# Uretim komutlari:
#   POSTGRES_PASSWORD   : openssl rand -hex 24
#   MINIO_ACCESS_KEY    : openssl rand -hex 12
#   MINIO_SECRET_KEY    : openssl rand -hex 24
#   MASTER_KEY          : python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   SHOWIS_API_TOKEN    : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# (MASTER_KEY Fernet anahtaridir — degistirilirse mevcut sifreli sir'lar acilamaz: rotasyon
#  icin docs/runbook.md "Uretim oncesi kontrol listesi".)

APP_ENV=development
LOG_LEVEL=INFO
USE_CELERY=1

POSTGRES_USER=showis
# ZORUNLU (fail-fast): bos birakilirsa compose hata verir.
POSTGRES_PASSWORD=
POSTGRES_DB=showis

# ZORUNLU (fail-fast): Fernet anahtari; bos ise compose hata verir.
MASTER_KEY=

# --- MinIO / S3 kimlik bilgileri (api + minio servisi) ---------------------
# ZORUNLU (fail-fast): `minioadmin` varsayilani kaldirildi (T-336).
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=showis-evidence

# --- T-111: kimlik dogrulama (SEC-01) ---------------------------------------
# API paylasilan token'i. ZORUNLU: bos ise `docker compose` fail-fast eder,
# container tarafinda da API fail-closed (503) davranir.
# Uretim:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SHOWIS_API_TOKEN=

# Caddy basic_auth (opsiyonel ikinci savunma, yalniz UI yollarina uygulanir).
# Bos birakilirsa basic_auth devre disi kalir ve baslangicta uyari loglanir.
# Hash uretimi (duz parola YAZILMAZ):
#   docker run --rm caddy:2.7-alpine caddy hash-password --plaintext 'PAROLA'
SHOWIS_CADDY_USER=
SHOWIS_CADDY_PASSWORD_HASH=

# --- Tarama kurtarma / worker (T-107) --------------------------------------
# Esigi asan queued/running taramalar bu sure sonunda kurtarilir (saniye).
SHOWIS_STALE_SCAN_SECONDS=1800
# Yeniden kuyruga atma denemesi; asilirsa tarama failed isaretlenir.
SHOWIS_SCAN_MAX_RECOVERY_ATTEMPTS=2
# showis.scan.run gorev retry sayisi (ustel backoff ile).
SHOWIS_SCAN_MAX_RETRIES=2
# Recovery beat araligi (saniye).
SHOWIS_SCAN_RECOVERY_INTERVAL=120
# Worker prefork cocuk sayisi (mem_limit 1g ile 2 onerilir).
SHOWIS_WORKER_CONCURRENCY=2
SHOWIS_SCAN_QUEUE=osint

# --- Tarama yurutme (T-101 / T-102) ----------------------------------------
# Ayni anda ucacak gorev sayisi (1..8; 1 = eski sirali davranis).
SHOWIS_SCAN_CONCURRENCY=
# Host (netloc) basina es zamanli istek siniri.
SHOWIS_HOST_MAX_CONCURRENCY=
# Ayni host'a iki istek arasi asgari saniye.
SHOWIS_HOST_MIN_INTERVAL=
# Site-check sonuc onbellegi TTL'i (saniye; 0 = kapali).
SHOWIS_SITECHECK_CACHE_TTL=

# --- API sinirlari (T-114 / T-302 / T-320) --------------------------------
# Istek govdesi ust siniri (bayt). Asilirsa 413.
SHOWIS_MAX_BODY_BYTES=
# SSE akis omru (saniye) ve abone basina kuyruk kapasitesi.
SHOWIS_SSE_MAX_SECONDS=
SHOWIS_SSE_QUEUE_MAXSIZE=
# /docs, /redoc, /openapi.json — varsayilan kapali; acikken token ister.
SHOWIS_DOCS_ENABLED=
# CORS origin allowlist'i (virgulle ayrilmis).
SHOWIS_ALLOWED_ORIGINS=
# Caddy vhost host allowlist'i (virgulle ayrilmis; T-319).
SHOWIS_ALLOWED_HOSTS=

# --- LLM (BYOK) -----------------------------------------------------------
# LLM base_url host allowlist'i (SSRF korumasi; virgulle ayrilmis).
SHOWIS_LLM_BASE_URL_ALLOWLIST=
