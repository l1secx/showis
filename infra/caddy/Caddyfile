# Showis — tek giris noktasi (T-111 / T-113 / T-319)
#
#   tarayici --HTTP--> :8083 (bu Caddy)
#     /health -> api:8000  (container healthcheck; kimlik dogrulamasi YOK, TAM eslesme)
#     /api/*  -> web:3000  (Next.js route handler; X-API-Token'i SUNUCU tarafinda ekler)
#     /*      -> web:3000  (UI)
#
# Erisim modeli (T-113):
#   * Edge kimlik dogrulamasi = HTTP Basic (basicauth @gate). /health DISINDA her yol
#     korumali: UI + /api/*.
#   * /api/* Next proxy'sine gider; proxy token'i her istege kendisi ekliyor. Yani
#     X-API-Token edge'de ayirt edici degil, tek gercek kapi basic auth.
#   * SSE (text/event-stream): ayni origin'de tarayici basic auth kimligini EventSource
#     istegine otomatik ekler; `connect-src 'self'` ile CSP altinda da calisir.
#
# Sertlestirme (T-319):
#   * X-Forwarded-For / X-Real-IP istemciden gelirse EZILIR; yerine gercek peer yazilir
#     ({http.request.remote.host}) — API `client_ip()` XFF'e guvendigi icin bu kritik.
#   * Guvenlik basliklari: nosniff, X-Frame-Options, Referrer-Policy, Permissions-Policy;
#     UI'da ayrica CSP. API yanitlarina CSP eklenmez (JSON), yalniz nosniff/XFO/Referrer.
#   * HSTS EKLENMEZ: bu site duz HTTP (:8083). HTTPS'e gecildiginde
#     `header Strict-Transport-Security "max-age=31536000; includeSubDomains"` eklenmeli.
#   * Govde siniri: /api/* 10MB, UI 5MB — asilirsa 413.
#   * Host dogrulamasi: SHOWIS_ALLOWED_HOSTS doluysa diger Host'lara 421 (render edilir).
#   * `Server` basligi gizlenir (hem Caddy hem upstream: header_down).

:8083 {
	# /health disindaki her sey edge kimlik dogrulamasina tabi. `path` TAM eslesir;
	# `/health/../api` gibi yollar normalize edilip /api olur ve gate'e girer.
	@gate {
		not path /health /healthz
	}

	# Render edilen blok 1: basic auth (env doluysa).
	# Hash: caddy hash-password --plaintext '<parola>' — duz parola commit edilmez.
	__BASIC_AUTH_PLACEHOLDER__

	# Render edilen blok 2: Host allowlist (SHOWIS_ALLOWED_HOSTS doluysa 421).
	__HOST_CHECK_PLACEHOLDER__

	# Govde siniri (istek govdesi okunmadan reddedilir -> 413).
	@api path /api/*
	@ui not path /api/* /health
	request_body @api {
		max_size 10MB
	}
	request_body @ui {
		max_size 5MB
	}

	# T-329: /metrics yalniz yerel kaynaklardan (Prometheus host'ta calisir).
	# Olculdu: host'tan 127.0.0.1:8083'e gelen istek konteynerde 172.17.0.1 (docker
	# gateway) olarak gorunur; LAN istemcisi kendi IP'siyle gorunur. Bu yuzden
	# 127.0.0.1/::1 + docker kopru araligi (172.16.0.0/12) izinli, digerleri 403.
	# (/metrics ayrıca token ister — defense in depth.)
	@metrics_remote_denied {
		path /api/v1/metrics
		not remote_ip 127.0.0.1 ::1 172.16.0.0/12
	}
	handle @metrics_remote_denied {
		respond "Forbidden" 403
	}

	# T-330/F-04: derin saglik ucu — kimliksiz (yalniz ok|degraded + check adlari).
	handle /healthz {
		header -Server
		header X-Content-Type-Options nosniff
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Real-IP {http.request.remote.host}
			header_down -Server
			header_down -X-Powered-By
		}
	}

	# Healthcheck muaftir: token/basic auth istemez. TAM eslesme.
	handle /health {
		header -Server
		header X-Content-Type-Options nosniff
		reverse_proxy api:8000 {
			# NOT (olculdu): `header_up -X-Forwarded-For` + `header_up X-Forwarded-For <val>`
			# kombinasyonu Caddy 2.7'de BASLIGI SILER (set'i de kaldirir) -> upstream'e
			# bos deger gider. Bu yuzden yalniz "set" kullaniyoruz: istemcinin uydurdugu
			# deger tamamen EZILIR (test: sahte 1.2.3.4 -> upstream 127.0.0.1 gorur).
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Real-IP {http.request.remote.host}
			header_down -Server
			header_down -X-Powered-By
		}
	}

	# /api/* -> Next.js sunucu tarafli proxy (token burada, sunucu tarafinda eklenir).
	# SSE akislari da bu yoldan gecer; tamponlama kapali olmali.
	handle /api/* {
		header -Server
		header X-Content-Type-Options nosniff
		header X-Frame-Options DENY
		header Referrer-Policy no-referrer
		header Permissions-Policy "geolocation=(), microphone=(), camera=()"
		reverse_proxy web:3000 {
			# NOT (olculdu): `header_up -X-Forwarded-For` + `header_up X-Forwarded-For <val>`
			# kombinasyonu Caddy 2.7'de BASLIGI SILER (set'i de kaldirir) -> upstream'e
			# bos deger gider. Bu yuzden yalniz "set" kullaniyoruz: istemcinin uydurdugu
			# deger tamamen EZILIR (test: sahte 1.2.3.4 -> upstream 127.0.0.1 gorur).
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Real-IP {http.request.remote.host}
			header_down -Server
			header_down -X-Powered-By
			# SSE / uzun suren istekler icin akis tamponlamasi kapali
			flush_interval -1
		}
	}

	handle {
		# UI: CSP dahil tam baslik seti. `script-src 'unsafe-inline'` Next.js inline
		# bootstrap'i icin; `connect-src 'self'` EventSource/SSE'yi kapsar.
		header -Server
		header X-Content-Type-Options nosniff
		header X-Frame-Options DENY
		header Referrer-Policy no-referrer
		header Permissions-Policy "geolocation=(), microphone=(), camera=()"
		header Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		reverse_proxy web:3000 {
			# NOT (olculdu): `header_up -X-Forwarded-For` + `header_up X-Forwarded-For <val>`
			# kombinasyonu Caddy 2.7'de BASLIGI SILER (set'i de kaldirir) -> upstream'e
			# bos deger gider. Bu yuzden yalniz "set" kullaniyoruz: istemcinin uydurdugu
			# deger tamamen EZILIR (test: sahte 1.2.3.4 -> upstream 127.0.0.1 gorur).
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Real-IP {http.request.remote.host}
			header_down -Server
			header_down -X-Powered-By
			flush_interval -1
		}
	}
}
