FROM mcr.microsoft.com/playwright/python:v1.55.0-noble

WORKDIR /app

ENV PYTHONUNBUFFERED=1

# Bağımlılıklar: web framework + HTTP istemcisi + proje paketleri
RUN pip install --no-cache-dir fastapi uvicorn pydantic httpx

COPY packages/contracts /app/packages/contracts
COPY packages/engine /app/packages/engine
RUN pip install --no-cache-dir /app/packages/contracts /app/packages/engine

ENV PYTHONPATH=/app/packages/engine:/app/packages/contracts

RUN useradd -u 10001 -m browseruser && chown -R browseruser:browseruser /app
USER browseruser

EXPOSE 8081

CMD ["uvicorn", "showis_engine.browser_service:app", "--host", "0.0.0.0", "--port", "8081"]
