{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "bindings": [
        { "type": "service", "service": "api", "format": "url", "env": "API_URL" }
      ]
    },
    "api": {
      "runtime": "container",
      "root": ".",
      "entrypoint": "infra/docker/Dockerfile.api",
      "command": ["sh", "-c", "exec /app/entrypoint-api.sh uvicorn showis.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
    }
  },
  "daemons": {
    "worker": {
      "root": ".",
      "entrypoint": "infra/docker/Dockerfile.worker",
      "instances": { "iad1": 1 },
      "terminationGracePeriodSeconds": 120,
      "resources": { "requests": { "memory": "2Gi" } }
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
