      "button-secondary": {
        "html": "<button class=\"ds-btn-secondary\">Dışa aktar</button>",
        "css": ".ds-btn-secondary {\n  display: inline-flex; align-items: center; justify-content: center; gap: 6px;\n  padding: 7px 12px; border: 1px solid #B4BBC4; border-radius: 6px;\n  background: #FFFFFF; color: #4A525E;\n  font: 500 13px/1.45 Inter, ui-sans-serif, system-ui, sans-serif;\n  cursor: pointer; transition: border-color 150ms ease, color 150ms ease;\n}\n.ds-btn-secondary:hover { border-color: #616A76; color: #15181D; }\n.ds-btn-secondary:focus-visible { outline: 2px solid #1B3A5B; outline-offset: 2px; }"
      },
      "button-danger-quiet": {
        "html": "<button class=\"ds-btn-danger\">Kaydı sil</button>",
        "css": ".ds-btn-danger {\n  display: inline-flex; align-items: center; justify-content: center; gap: 6px;\n  padding: 5px 10px; border: 1px solid transparent; border-radius: 6px;\n  background: transparent; color: #93342A;\n  font: 500 12px/1.45 Inter, ui-sans-serif, system-ui, sans-serif;\n  cursor: pointer; transition: background-color 150ms ease;\n}\n.ds-btn-danger:hover { background: #F7EBE9; }\n.ds-btn-danger:focus-visible { outline: 2px solid #1B3A5B; outline-offset: 2px; }"
      },
      "input-search": {
        "html": "<div class=\"ds-search\"><span class=\"ds-search-icon\"></span><input class=\"ds-search-input\" placeholder=\"Vaka adı, yasal amaç veya hedef kimliği ile arayın\" /></div>",
        "css": ".ds-search { position: relative; display: block; }\n.ds-search-icon { position: absolute; left: 12px; top: 50%; width: 12px; height: 12px;\n  margin-top: -6px; border: 1.5px solid #616A76; border-radius: 50%; }\n.ds-search-input {\n  width: 100%; padding: 7px 12px 7px 34px;\n  border: 1px solid #B4BBC4; border-radius: 6px; background: #FFFFFF; color: #15181D;\n  font: 400 13.5px/1.55 Inter, ui-sans-serif, system-ui, sans-serif;\n}\n.ds-search-input::placeholder { color: #616A76; }\n.ds-search-input:focus { border-color: #1B3A5B; outline: none; box-shadow: 0 0 0 2px rgba(27,58,91,0.15); }"
      },
      "panel-record": {
        "html": "<div class=\"ds-panel\">\n  <div class=\"ds-panel-head\"><span class=\"ds-panel-title\">Hedef</span></div>\n  <div class=\"ds-panel-body\">İsim tek başına yeterlidir, ipuçları doğrulamayı güçlendirir</div>\n</div>",
        "css": ".ds-panel { border: 1px solid #D6DAE0; border-radius: 8px; background: #FFFFFF; overflow: hidden; }\n.ds-panel-head { display: flex; align-items: center; justify-content: space-between;\n  gap: 12px; padding: 14px 20px; border-bottom: 1px solid #D6DAE0; background: #FFFFFF; }\n.ds-panel-title { font: 600 15px/1.3 Inter, ui-sans-serif, system-ui, sans-serif; color: #15181D; }\n.ds-panel-body { padding: 20px; font: 400 13.5px/1.55 Inter, ui-sans-serif, system-ui, sans-serif; color: #616A76; }"
      },
      "table-register": {
        "html": "<table class=\"ds-table\"><thead><tr><th>Kayıt ve hedef</th><th>Durum</th><th class=\"ds-num\">Skor</th></tr></thead>\n<tbody><tr><td><span class=\"ds-strong\">Kerem Boz — kendi hesap envanteri</span><span class=\"ds-mono\">@kerem, Kerem Boz</span></td>\n<td><span class=\"ds-dot\"></span>Aktif</td><td class=\"ds-num\">94</td></tr></tbody></table>",
        "css": ".ds-table { width: 100%; border-collapse: collapse; background: #FFFFFF;\n  border: 1px solid #D6DAE0; border-radius: 8px; overflow: hidden;\n  font: 400 13px/1.5 Inter, ui-sans-serif, system-ui, sans-serif; }\n.ds-table th { background: #F3F5F7; color: #616A76; text-align: left; font-weight: 500; font-size: 12px;\n  padding: 10px 16px; border-bottom: 1px solid #B4BBC4; }\n.ds-table td { padding: 12px 16px; border-bottom: 1px solid #D6DAE0; color: #4A525E; }\n.ds-table tbody tr:last-child td { border-bottom: 0; }\n.ds-table tbody tr:hover td { background: #F1F3F6; }\n.ds-strong { display: block; color: #15181D; font-weight: 500; font-size: 13.5px; }\n.ds-mono { display: block; font: 400 12px/1.45 \"JetBrains Mono\", ui-monospace, monospace; color: #616A76; margin-top: 2px; }\n.ds-dot { display: inline-block; width: 6px; height: 6px; margin-right: 6px; border-radius: 50%; background: #2A5B3F; }\n.ds-num { text-align: right; font-variant-numeric: tabular-nums; }"
      },
      "status-ok": {
        "html": "<span class=\"ds-status-ok\"><span class=\"ds-dot-ok\"></span>onaylandı</span>",
        "css": ".ds-status-ok { display: inline-flex; align-items: center; gap: 6px;\n  color: #2A5B3F; font: 500 12px/1.45 Inter, ui-sans-serif, system-ui, sans-serif; }\n.ds-dot-ok { width: 6px; height: 6px; border-radius: 50%; background: #2A5B3F; }"
      },
      "status-warn": {
        "html": "<span class=\"ds-status-warn\"><span class=\"ds-dot-warn\"></span>aday</span>",
        "css": ".ds-status-warn { display: inline-flex; align-items: center; gap: 6px;\n  color: #855F14; font: 500 12px/1.45 Inter, ui-sans-serif, system-ui, sans-serif; }\n.ds-dot-warn { width: 6px; height: 6px; border-radius: 50%; background: #855F14; }"
      },
      "meter": {
        "html": "<div class=\"ds-meter-wrap\"><span class=\"ds-meter-label\">güven puanı</span>\n<span class=\"ds-meter\"><span class=\"ds-meter-fill\"></span></span></div>",
        "css": ".ds-meter-wrap { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }\n.ds-meter-label { font: 400 12px/1.45 Inter, ui-sans-serif, system-ui, sans-serif; color: #616A76; }\n.ds-meter { display: block; width: 96px; height: 3px; border-radius: 1px; background: #D6DAE0; overflow: hidden; }\n.ds-meter-fill { display: block; height: 100%; width: 94%; background: #1B3A5B; }"
      },
      "nav-underline": {
        "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-link ds-active\">Vakalar</a><a class=\"ds-nav-link\">Yeni vaka</a><a class=\"ds-nav-link\">Ayarlar</a></nav>",
        "css": ".ds-nav { display: flex; gap: 24px; height: 56px; align-items: center;\n  border-bottom: 1px solid #D6DAE0; background: #FFFFFF; }\n.ds-nav-link { position: relative; display: flex; align-items: center; height: 56px;\n  color: #616A76; text-decoration: none;\n  font: 400 13px/1.45 Inter, ui-sans-serif, system-ui, sans-serif; }\n.ds-nav-link:hover { color: #15181D; }\n.ds-nav-link.ds-active { color: #15181D; font-weight: 500; }\n.ds-nav-link.ds-active::after { content: \"\"; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: #1B3A5B; }\n.ds-nav-link:focus-visible { outline: 2px solid #1B3A5B; outline-offset: 2px; }"
      },
      "theme-toggle": {
        "html": "<button class=\"ds-theme-toggle\" aria-label=\"Koyu temaya geç\">\n  <svg viewBox=\"0 0 24 24\" width=\"15\" height=\"15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"ds-icon\"><path d=\"M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z\"/></svg>\n</button>",
        "css": ".ds-theme-toggle {\n  display: inline-flex; align-items: center; justify-content: center;\n  width: 32px; height: 32px; padding: 0;\n  border: 1px solid transparent; border-radius: 6px;\n  background: transparent; color: #616A76; cursor: pointer;\n  transition: background-color 150ms ease, color 150ms ease;\n}\n.ds-theme-toggle:hover { background: #F1F3F6; color: #15181D; }\n.ds-theme-toggle:focus-visible { outline: 2px solid #1B3A5B; outline-offset: 2px; }\n.ds-icon { display: block; }"
      }
    }
  },
  "narrative": {
    "northStar": "The Case File (dosya masası)",
    "overview": "Showis bir platform değil, açılmış bir dosya: hedef, tarama, bulgular, kanıt zinciri ve denetim izi. Arayüzün bütün işi bu dosyayı okunabilir ve savunulabilir kılmaktır.\n\nYüzey bir uygulama kabuğu gibi değil, evrak masası gibi kurulur: soğuk kâğıt grisi zemin, üzerinde beyaz sayfalar, ince ve tek çizgiler, mürekkep lacivert bir eylem rengi.",
    "keyCharacteristics": [
      "Düz ve tonlu: gölge neredeyse hiç yok, derinlik 1px çizgiyle ve yüzey tonuyla anlatılır.",
      "Sayılar öne çıkar; monospace yalnız kod, hash, kimlik ve ölçüde.",
      "Durum bir rozet değil: nokta + metin.",
      "Boşluk yapı taşır; bölümler kutuyla değil ayraçla ayrılır.",
      "Tek eylem rengi: lacivert yalnız eylem içindir."
    ],
    "rules": [
      {
        "name": "The Single Ink Rule",
        "body": "Eylem için tek bir renk vardır: mürekkep lacivert. Durum renkleri anlam taşır ve yalnız durumda kullanılır.",
        "section": "colors"
      },
      {
        "name": "The Two-Weight Rule",
        "body": "Metin hiyerarşisi renk koyuluğuyla değil, ağırlık ve boyutla kurulur. Üç metin tonu vardır; dördüncüsü yoktur.",
        "section": "typography"
      },
      {
        "name": "The Flat Rule",
        "body": "Yükselti bir kez ilan edilir: 1px çizgi. Gölge yalnız gerçekten yüzen yüzeyde kullanılır.",
        "section": "elevation"
      },
      {
        "name": "The Measured Line Rule",
        "body": "Gövde metni 66–72 karakterde sınırlanır; 80 karakteri geçmez.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do yeni renk eklerken app/globals.css içindeki semantik tokenları kullan; sayfalarda kademe adları yazma.",
      "Do durumu her zaman nokta ve metin ile birlikte göster; renk tek başına anlam taşımaz.",
      "Do sayıları tabular rakamla yaz.",
      "Do gövde metnini max-w-[66ch] ile sınırla.",
      "Do eylemi söyle: 'Yakayı sil' değil, 'Kaydı sil'."
    ],
    "donts": [
      "Don't başlığın üstüne eyebrow etiketi (ALL-CAPS) koy.",
      "Don't durumları rozet çorbasına döndürme.",
      "Don't her bölümü kart içine koy.",
      "Don't koyu zemin + neon aksan klişesine dön.",
      "Don't gölgeyi dekorasyon olarak kullan.",
      "Don't monospace'ı teknik görünmek için kullan.",
      "Don't bağlantı metnine '→' ekle.",
      "Don't 12px'in altına inme."
    ]
  }
}
