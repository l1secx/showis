# Showis — gelistirme ortami ornegi (`cp .env.example .env`)
# DEGER YAZMAYIN: gercek degerler yalniz `.env` / `infra/.env` icinde tutulur,
# repoya girmez. Bu dosya yalniz **anahtar adlarini** belgeler.

# --- Cekirdek ---------------------------------------------------------------
APP_ENV=
LOG_LEVEL=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
REDIS_URL=

MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_SECURE=

# BYOK sirlarini sifreleyen anahtar (zorunlu).
MASTER_KEY=

BROWSER_SERVICE_URL=
SENTRY_DSN=
SHOWIS_REPORT_DIR=
SHOWIS_EVIDENCE_DIR=

# --- Kimlik dogrulama (T-108 / T-111) ---------------------------------------
# API paylasilan token'i. ZORUNLU: bos ise API fail-closed (503) davranir.
# Istemci: `X-API-Token: <token>` veya `Authorization: Bearer <token>`.
SHOWIS_API_TOKEN=
# Edge (Caddy) basic auth kullanicisi ve parola hash'i (opsiyonel 2. katman).
SHOWIS_CADDY_USER=
SHOWIS_CADDY_PASSWORD_HASH=
# Çok kullanıcılı edge: "kullanici:bcrypt_hash;kullanici2:bcrypt_hash".
# Doluysa SHOWIS_CADDY_USER/HASH yerine bu liste kullanılır.
SHOWIS_CADDY_USERS=
# Edge basic auth doğrulaması API forward_auth ucunda (audit + rate-limit).
SHOWIS_EDGE_FORWARD_AUTH=0
# TLS (8443) sertifika alacak host/IP listesi; virgülle ayrılır.
SHOWIS_TLS_HOSTS=localhost,127.0.0.1
# YALNIZ test/dev bypass'i — prod'da ASLA set etmeyin (API CRITICAL loglar).
SHOWIS_AUTH_DISABLED=
# CORS allowlist (virgulle ayrilmis origin listesi). Bos ise guvenli varsayilan.
SHOWIS_ALLOWED_ORIGINS=
# Caddy/vhost host allowlist'i (virgulle ayrilmis).
SHOWIS_ALLOWED_HOSTS=

# --- Tarama yurutme --------------------------------------------------------
# Ayni anda ucacak gorev sayisi (1..8, varsayilan 4; 1 = sirali).
SHOWIS_SCAN_CONCURRENCY=
# Host basina es zamanli istek siniri (varsayilan 2).
SHOWIS_HOST_MAX_CONCURRENCY=
# Ayni host'a iki istek arasi asgari saniye (varsayilan 0.25).
SHOWIS_HOST_MIN_INTERVAL=
# Site-check sonuc onbellegi TTL'i (saniye; 0 = kapali).
SHOWIS_SITECHECK_CACHE_TTL=

# --- API sinirlari --------------------------------------------------------
# Istek govdesi ust siniri (bayt, varsayilan 8 MB). Asilirsa 413.
SHOWIS_MAX_BODY_BYTES=
# SSE akis omru (saniye, varsayilan 900).
SHOWIS_SSE_MAX_SECONDS=
# Abone basina SSE kuyruk kapasitesi (varsayilan 500; dolunca en eski dusurulur).
SHOWIS_SSE_QUEUE_MAXSIZE=
# API dokumantasyonu (/docs, /openapi.json). Varsayilan kapali; acikken token ister.
SHOWIS_DOCS_ENABLED=

# --- LLM (BYOK) -----------------------------------------------------------
# LLM base_url host allowlist'i (virgulle ayrilmis; SSRF korumasi).
SHOWIS_LLM_BASE_URL_ALLOWLIST=

# Edge kullanıcısını X-Actor başlığıyla API'ye taşı (Caddy arkasında 1).
SHOWIS_TRUST_ACTOR_HEADER=0
# X-Actor kullanıcı -> rol eşlemesi: "analyst:admin,viewer:viewer".
SHOWIS_ACTOR_ROLES=
